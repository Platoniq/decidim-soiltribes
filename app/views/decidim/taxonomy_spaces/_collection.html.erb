<h2 class="h5 md:h3 decorator">
  <%= t("decidim.taxonomy_spaces.index.spaces_count", count: collection.total_count) %>
</h2>

<% if collection.any? %>
  <div class="card__grid-grid">
    <% collection.each do |space| %>
      <%= card_for space %>
    <% end %>
  </div>

  <%= decidim_paginate collection %>
<% else %>
  <p><%= t("decidim.taxonomy_spaces.index.empty") %></p>
<% end %>
