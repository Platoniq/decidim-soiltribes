<% content_for :header_snippets do %>
  <style>
    .layout-2col__aside { grid-column: span 3 / span 3; padding-right: 2rem; }
    .layout-2col__main  { grid-column: span 9 / span 9; padding-left: 2rem; }
  </style>
<% end %>

<% content_for :aside do %>
  <h1 class="title-decorator"><%= t("decidim.taxonomy_spaces.index.title") %></h1>

  <%= render partial: "decidim/shared/filters", locals: { filter_sections:, skip_to_id: "spaces-grid" } %>
<% end %>

<%= render layout: "layouts/decidim/shared/layout_two_col" do %>
  <section id="spaces-grid" class="layout-main__section layout-main__heading">
    <%= render partial: "collection" %>
  </section>
<% end %>
